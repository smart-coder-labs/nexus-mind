# oracle box runtime env — TEMPLATE.
#
# The deploy workflow writes the real `.env` next to docker-compose.yml from the
# `oracle-production` GitHub Environment secrets. This template documents every
# key the box needs. Values mirror the Fly deployment (fly.toml [env] + the
# `fly secrets` set). Fly does not reveal secret values, so pull them from your
# own secret store / the original source, not from `fly secrets list`.

# --- Deploy plumbing (consumed by compose, not the app) ---
GHCR_OWNER=smart-coder-labs           # lowercase GitHub owner for the image path
CLOUDFLARE_API_TOKEN=                  # REQUIRED: Zone:DNS:Edit on smartcoderlabs.com (Caddy TLS)

# --- App runtime (from fly.toml [env]) ---
DB_PATH=/data/nexusmind.db
RUST_LOG=info
ADMIN_ORIGIN=https://admin.nexusmind.smartcoderlabs.com

# --- App secrets (from `fly secrets` — REQUIRED, values not shown) ---
SUPERUSER_KEY=
# CRITICAL: must be byte-for-byte identical to Fly's, or GitHub-connection tokens
# stored in the migrated DB become permanently undecryptable.
NEXUSMIND_TOKEN_ENCRYPTION_KEY=

# OAuth (GitHub app). Redirect URI must match the app registration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Outbound email
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# URLs / CORS
APP_BASE_URL=
CORS_ORIGINS=

# Embeddings + backup cadence
NEXUSMIND_EMBED_ENABLED=
BACKUP_DATABASE_URL=
BACKUP_INTERVAL_HOURS=
