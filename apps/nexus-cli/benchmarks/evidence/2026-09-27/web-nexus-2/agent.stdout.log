-body { font-family: sans-serif; }
+:root {
+  color: #172033;
+  background: #f5f7fb;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+* { box-sizing: border-box; }
+
+body { margin: 0; }
+
+.catalogo { max-width: 1120px; margin: 0 auto; padding: 3rem 1.25rem 4rem; }
+.catalogo__cabecera { max-width: 680px; margin-bottom: 2rem; }
+.catalogo__eyebrow { margin: 0 0 .45rem; color: #5b3fc6; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: .78rem; }
+h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.08; }
+.catalogo__cabecera > p:last-child { color: #586174; line-height: 1.55; }
+
+.filtros { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(170px, 1fr)); gap: 1rem; padding: 1rem; background: #fff; border: 1px solid #e4e8f0; border-radius: 1rem; box-shadow: 0 8px 24px rgb(23 32 51 / 6%); }
+.campo { display: grid; gap: .42rem; min-width: 0; }
+label { font-weight: 650; font-size: .9rem; }
+input, select { width: 100%; min-width: 0; min-height: 2.75rem; padding: .65rem .75rem; color: inherit; font: inherit; background: #fff; border: 1px solid #b8c0d0; border-radius: .55rem; }
+input:focus, select:focus { outline: 3px solid #bcaeff; outline-offset: 2px; border-color: #6748d7; }
+.resumen { min-height: 1.5rem; margin: 1.4rem 0 .85rem; color: #586174; }
+
+.productos { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
+.producto { display: flex; flex-direction: column; min-height: 175px; padding: 1.25rem; background: #fff; border: 1px solid #e4e8f0; border-radius: .9rem; box-shadow: 0 5px 18px rgb(23 32 51 / 5%); }
+.producto__categoria { margin: 0 0 .65rem; color: #5b3fc6; font-size: .82rem; font-weight: 700; }
+.producto__nombre { margin: 0; font-size: 1.15rem; line-height: 1.3; }
+.producto__precio { margin: auto 0 0; padding-top: 1.25rem; font-size: 1.2rem; font-weight: 750; }
+.estado-vacio { grid-column: 1 / -1; padding: 2.5rem 1rem; text-align: center; background: #fff; border: 1px dashed #b8c0d0; border-radius: .9rem; color: #586174; }
+.estado-vacio h2 { margin: 0 0 .4rem; color: #172033; font-size: 1.2rem; }
+.estado-vacio p { margin: 0; }
+
+@media (max-width: 680px) {
+  .catalogo { padding-top: 2rem; }
+  .filtros { grid-template-columns: 1fr; }
+}

