---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'NexusMind — AI Control Plane', description = 'El control plane que unifica todas las herramientas AI de tu empresa. Memoria cross-tool, políticas de gobierno y trazabilidad para Claude Code, Cursor, Copilot y cualquier agente.' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="overflow-x-hidden">
    <slot />
  </body>
</html>
