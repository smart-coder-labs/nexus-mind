---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import EarlyAdopters from '../components/EarlyAdopters.astro';
import SocialProof from '../components/SocialProof.astro'; // TODO: enable when we have real customers
// Problem + Solution now told cinematically by GovernScene (scene 1).
// import Problem from '../components/Problem.astro';
// import Solution from '../components/Solution.astro';
import GovernScene from '../components/react/GovernScene.tsx';
// Cinematic redesign: the robot now appears per-scene as a narrative thread
// (see HeroRobot + upcoming pinned scenes) rather than one globally-roaming
// mascot, so the earlier FloatingMascot is retired.
// import FloatingMascot from '../components/react/FloatingMascot.tsx';
import Features from '../components/Features.astro';
import SupabaseClient from '../components/SupabaseClient.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import ToastAndReveal from '../components/ToastAndReveal.astro';
import ForTeams from '../components/ForTeams.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <Hero />
  <EarlyAdopters />
  {/* <SocialProof /> */}
  <GovernScene client:load />
  <Features />
  <ForTeams />
  <WaitlistForm />
  <Footer />
  <SupabaseClient />
  <ToastAndReveal />
</Layout>
