---
// Supabase client — ready for your credentials
// Replace NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY below
---

<script>
  // ⚠️  Replace these with your Supabase project details
  //     (Settings > API > Project URL + anon public key)
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

  // Inline minimal Supabase client — no dependency needed for a simple insert
  // Falls back gracefully to localStorage if Supabase isn't configured
  async function submitToSupabase(entry) {
    if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
      // Fallback: save to localStorage
      const existing = JSON.parse(localStorage.getItem('nexusmind_waitlist') || '[]');
      existing.push(entry);
      localStorage.setItem('nexusmind_waitlist', JSON.stringify(existing));
      return { ok: true, fallback: 'localStorage' };
    }

    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/waitlist`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify({
          name: entry.name,
          email: entry.email,
          company: entry.company,
          team_size: entry.size,
          interests: entry.interests,
          message: entry.message,
        }),
      });

      if (!res.ok) throw new Error(`Supabase returned ${res.status}`);
      return { ok: true };
    } catch (err) {
      console.error('Supabase insert failed:', err);
      // Fallback: save to localStorage
      const existing = JSON.parse(localStorage.getItem('nexusmind_waitlist') || '[]');
      existing.push(entry);
      localStorage.setItem('nexusmind_waitlist', JSON.stringify(existing));
      return { ok: true, fallback: 'localStorage' };
    }
  }

  window.__nexusmindSubmit = submitToSupabase;
</script>
