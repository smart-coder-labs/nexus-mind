---
// Solution — repositioned as control plane, not replacement
import Icon from './ui/Icon/Icon.astro';
---

<section class="py-20 px-4" style="background: var(--color-bg-secondary);" data-reveal>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="tile-label" style="color: var(--color-status-success);">La Solución</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 text-text-primary">Control plane, no competencia</h2>
      <p class="mt-3 max-w-xl mx-auto" style="color: var(--color-text-secondary);">No reemplazamos tus herramientas. Les damos superpoderes.</p>
    </div>

    <div class="ds-surface p-8 md:p-10 max-w-4xl mx-auto" data-reveal>
      <!-- Upper row: tools -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm mb-4" style="color: var(--color-text-primary);">
        <span class="bg-white/5 px-4 py-2 rounded-full hover:bg-white/10 transition-colors border border-accent-blue/20">Claude Code</span>
        <span class="bg-white/5 px-4 py-2 rounded-full hover:bg-white/10 transition-colors border border-accent-blue/20">Cursor</span>
        <span class="bg-white/5 px-4 py-2 rounded-full hover:bg-white/10 transition-colors border border-accent-blue/20">Copilot</span>
        <span class="bg-white/5 px-4 py-2 rounded-full hover:bg-white/10 transition-colors border border-accent-blue/20">OpenCode</span>
        <span class="bg-white/5 px-4 py-2 rounded-full hover:bg-white/10 transition-colors border border-accent-blue/20">Cline</span>
        <span class="bg-white/5 px-4 py-2 rounded-full hover:bg-white/10 transition-colors border border-accent-blue/20">CrewAI</span>
      </div>

      <!-- Arrow down -->
      <div class="flex justify-center my-3 text-accent-on-dark" style="opacity:0.6;"><Icon name="arrow-down" size={20} /></div>

      <!-- NexusMind control plane -->
      <div class="bg-accent-blue/10 border border-accent-blue/20 rounded-xl p-5 mb-4 max-w-lg mx-auto relative overflow-hidden">
        <span class="tile-glow" style="background: var(--color-accent-blue); top: -1.5rem; right: -1rem;" aria-hidden="true"></span>
        <div class="text-lg font-extrabold text-gradient-accent text-center relative">NexusMind Control Plane</div>
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1 mt-2 text-xs relative" style="color: var(--color-text-secondary);">
          <span class="inline-flex items-center gap-1.5"><Icon name="network" size={13} />Memoria</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="file-text" size={13} />Artefactos SDD</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="list-checks" size={13} />Tasks</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="package" size={13} />Harnesses</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="bot" size={13} />Agentes Autónomos</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="shield-check" size={13} />Policy Engine</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="scroll-text" size={13} />Audit Trail</span>
        </div>
      </div>

      <!-- Arrow down -->
      <div class="flex justify-center my-3 text-accent-on-dark" style="opacity:0.6;"><Icon name="arrow-down" size={20} /></div>

      <!-- Bottom: BYOM -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm" style="color: var(--color-text-secondary);">
        <span class="text-xs mr-1" style="color: var(--color-text-tertiary);">BYOM</span>
        <span class="bg-white/5 px-3 py-1.5 rounded-full">OpenAI</span>
        <span class="bg-white/5 px-3 py-1.5 rounded-full">Claude</span>
        <span class="bg-white/5 px-3 py-1.5 rounded-full">Gemini</span>
        <span class="bg-white/5 px-3 py-1.5 rounded-full">Local LLM</span>
      </div>

      <p class="mt-5 text-sm text-center" style="color: var(--color-text-secondary);">Memoria, artefactos SDD, tasks, harnesses y agentes autónomos para todas tus herramientas. <strong style="color: var(--color-status-success);">Sin reemplazar ninguna.</strong></p>
    </div>
  </div>
</section>
