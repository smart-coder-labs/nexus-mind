---
// Solution convergente
---

<section class="py-20 px-4 bg-surface-alt" data-reveal>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-xs font-semibold tracking-widest text-green-accent uppercase">The Solution</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 text-white">NexusMind lo unifica todo</h2>
    </div>
    <div class="rounded-2xl p-8 md:p-10 max-w-4xl mx-auto text-center" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);" data-reveal>
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-slate-300 mb-6">
        {['Copilot', 'CrewAI', 'Mem0', 'Retool', 'Okta'].map(name => (
          <Fragment>
            <span class="bg-white/5 px-4 py-2 rounded-full hover:bg-white/10 transition-colors">{name}</span>
            {name !== 'Okta' && <span class="text-slate-600">+</span>}
          </Fragment>
        ))}
      </div>
      <div class="text-accent text-2xl my-4 animate-bounce" style="animation-duration: 2s;">⬇</div>
      <span class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-300">NexusMind</span>
      <p class="text-slate-400 mt-3 text-sm">5 herramientas. Una plataforma. <strong class="text-green-accent">Hasta 40% de ahorro.</strong></p>
    </div>
  </div>
</section>
