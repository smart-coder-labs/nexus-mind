---
import WaitlistFormReact from './react/WaitlistFormReact.tsx';
---

<section id="waitlist" class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10" data-reveal>
        <span class="text-xs font-semibold tracking-widest text-accent uppercase">Get Early Access</span>
        <h2 class="text-3xl sm:text-4xl font-bold mt-3 text-white">Sé de los primeros en probar NexusMind</h2>
        <p class="mt-3" style="color: var(--color-text-secondary);">Completa el formulario y te avisaremos cuando tengamos slots disponibles para tu empresa.</p>
      </div>

      <div data-reveal>
        <WaitlistFormReact client:load />
      </div>
    </div>
  </div>
</section>
