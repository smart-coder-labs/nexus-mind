/**
 * Monochrome icon set (Lucide 24x24 geometry, stroke-based).
 *
 * Replaces the emoji that used to sit in the feature/problem/solution cards.
 * Emoji were full-colour by nature and rendered differently per OS, which broke
 * the single-accent rule the design system is built on. These inherit
 * `currentColor`, so an icon is coloured by its container's text token and
 * never introduces a hue of its own.
 *
 * Always decorative: the adjacent heading carries the meaning, so every icon is
 * `aria-hidden` and contributes nothing to the accessibility tree.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
}

