---
// Footer
---

<footer class="py-12 px-4" style="border-top: 1px solid var(--color-border-primary);">
  <div class="max-w-6xl mx-auto text-center">
    <div class="text-lg font-bold tracking-tight text-white mb-4">
      Nexus<span class="text-accent">Mind</span>
    </div>
    <div class="flex justify-center gap-6 text-sm mb-5" style="color: var(--color-text-tertiary);">
      {['Product', 'Docs', 'Blog', 'GitHub'].map(item => (
        <a class="transition-colors duration-200 cursor-pointer hover:opacity-80">{item}</a>
      ))}
    </div>
    <p class="text-xs" style="color: var(--color-text-tertiary);">Built with ❤️ for the AI community</p>
    <p class="text-xs mt-1" style="color: var(--color-text-tertiary);">2026 NexusMind. All rights reserved.</p>
  </div>
</footer>
