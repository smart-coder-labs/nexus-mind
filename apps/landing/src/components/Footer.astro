---
// Footer
---

<footer class="border-t border-white/5 py-12 px-4">
  <div class="max-w-6xl mx-auto text-center">
    <div class="text-lg font-bold tracking-tight text-white mb-4">
      Nexus<span class="text-accent">Mind</span>
    </div>
    <div class="flex justify-center gap-6 text-sm text-slate-500 mb-5">
      {['Product', 'Docs', 'Blog', 'GitHub'].map(item => (
        <a class="hover:text-slate-300 transition-colors duration-200 cursor-pointer">{item}</a>
      ))}
    </div>
    <p class="text-xs text-slate-600">Built with ❤️ for the AI community</p>
    <p class="text-xs text-slate-600 mt-1">2026 NexusMind. All rights reserved.</p>
  </div>
</footer>
