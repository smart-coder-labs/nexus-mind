---
import NavbarCTA from './react/NavbarCTA.tsx';
---

<nav
  id="navbar"
  class="fixed top-3 sm:top-4 left-1/2 -translate-x-1/2 w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] max-w-5xl z-50 rounded-2xl border border-white/[0.09] bg-[#0d0f14]/72 backdrop-blur-[16px] transition-shadow duration-300"
>
  <div class="flex items-center justify-between h-14 px-4 sm:px-5">
    <a href="#" class="text-lg font-bold tracking-tight text-text-primary">
      Nexus<span class="text-accent">Mind</span>
    </a>
    <div class="hidden sm:flex items-center gap-6 text-sm" style="color: var(--color-text-secondary);">
      <a href="#features" class="hover:text-white transition-colors duration-200">Características</a>
      <a href="#early" class="hover:text-white transition-colors duration-200">Acceso anticipado</a>
      <NavbarCTA client:load />
    </div>
    <!-- Mobile menu button -->
    <button id="mobileMenuBtn" class="sm:hidden hover:text-white p-2 rounded-lg" style="color: var(--color-text-primary);" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNav">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
  <!-- Mobile nav panel -->
  <div id="mobileNav" class="sm:hidden border-t max-h-0 overflow-hidden transition-all duration-300 rounded-b-2xl" style="border-color: var(--color-border-secondary);">
    <div class="flex flex-col gap-3 px-4 py-4 text-sm" style="color: var(--color-text-primary);">
      <a href="#features" class="hover:text-white transition-colors py-1">Features</a>
      <a href="#early" class="hover:text-white transition-colors py-1">Early Access</a>
      <a href="#waitlist" class="btn-pill btn-pill-primary text-center py-2">Unirme</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('navbar');
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileNav = document.getElementById('mobileNav');
  let mobileOpen = false;

  // Scroll handler: the nav is always a floating glass pill; scrolling only
  // adds a subtle shadow + brighter border so it lifts off the page content
  // behind it. (Previously this swapped inline background/backdrop-filter
  // styles directly, which fought with the new persistent glass classes.)
  window.addEventListener('scroll', () => {
    if (!nav) return;
    nav.classList.toggle('shadow-lg', window.scrollY > 60);
    nav.classList.toggle('border-white/[0.16]', window.scrollY > 60);
  });

  mobileBtn?.addEventListener('click', () => {
    mobileOpen = !mobileOpen;
    if (mobileNav) mobileNav.style.maxHeight = mobileOpen ? '300px' : '0';
    mobileBtn.setAttribute('aria-expanded', String(mobileOpen));
  });

  // Close mobile nav on link click
  mobileNav?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      mobileOpen = false;
      if (mobileNav) mobileNav.style.maxHeight = '0';
      mobileBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
