---
// Feature cards grid (9 features)
---

<section id="features" class="py-20 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14" data-reveal>
      <span class="tile-label text-accent">Características</span>
      <h2 class="text-3xl sm:text-4xl font-bold mt-3 text-text-primary">Un control plane,<br/>no otra herramienta.</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {[
        { icon: '🧠', title: 'Memoria Cross-Tool', desc: 'Contexto persistente entre Claude Code, Cursor, Copilot y cualquier agente. Sin repetir nada.' },
        { icon: '🔒', title: 'Policy Engine', desc: 'Reglas centralizadas que cualquier herramienta respeta. PII redaction, model whitelist, cost controls.' },
        { icon: '📋', title: 'Audit Trail Universal', desc: 'Todas las interacciones AI de tu empresa en un solo lugar. Inmutable, exportable, auditable.' },
        { icon: '🤖', title: 'Multi-Agent Orchestration', desc: 'Coordina Claude Code + CrewAI + Cline + agentes custom en flujos chain, fan-out y handoff.' },
        { icon: '🌐', title: 'Tool-Agnostic Plugins', desc: 'MCP protocol + SDKs + plugins oficiales para Claude Code, Cursor, Copilot, OpenCode y más.' },
        { icon: '🏢', title: 'Enterprise Admin', desc: 'RBAC granular, SSO (SAML/OIDC), dashboard de uso, analytics de costos cross-tool.' },
        { icon: '🔑', title: 'BYOM (Bring Your Model)', desc: 'Sin costos de LLM ocultos. Trae tus keys de OpenAI, Anthropic, Google o corre modelos locales.' },
        { icon: '🔐', title: 'On-prem / Self-hosted', desc: 'Single binary deploy. Sin dependencias externas. Tus datos nunca salen de tu infraestructura.' },
        { icon: '📦', title: 'Exportabilidad Total', desc: 'Zero lock-in. Memoria, políticas y audit trails se exportan. Si te vas, te llevas todo.' },
      ].map((f, i) => {
        // Reuse the app's existing status/accent tokens in a fixed rotation
        // instead of inventing new tile accent colors — same tradeoff already
        // made in apps/admin's MemoryStatTiles (status-error is skipped here
        // since it already means "problem" in the Problem section above).
        const accents = ['var(--color-accent-blue)', 'var(--color-status-success)', 'var(--color-status-warning)'];
        return (
        <div class="feature-card" data-reveal data-reveal-delay={i * 80}>
          <span class="tile-glow" style={`background: ${accents[i % accents.length]}`} aria-hidden="true"></span>
          <div class="text-3xl mb-3 relative">{f.icon}</div>
          <h3 class="font-semibold text-text-primary mb-1 relative">{f.title}</h3>
          <p class="text-sm leading-relaxed relative" style="color: var(--color-text-secondary);">{f.desc}</p>
        </div>
      );})}
    </div>
  </div>
</section>

<style>
  .feature-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--color-border-primary);
    border-radius: 1rem;
    padding: 1.75rem;
    transition: transform 0.3s var(--ease-apple), border-color 0.3s var(--ease-apple);
    position: relative;
    overflow: hidden;
  }
  .feature-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-hover);
  }
</style>
