# NexusMind backend — example environment variables.
# Copy to `.env` and fill in real values. NEVER commit `.env` to source control.

# HTTP server port (default 8080)
PORT=8080

# Path to the SQLite store. Use `./data/nexusmind.db` for local dev, or
# `/data/nexusmind.db` for the Fly.io deployment.
DB_PATH=./data/nexusmind.db

# Logging level (tracing-subscriber EnvFilter syntax). Default: info
LOG_LEVEL=info

# CORS allowed origins, comma-separated, or `*` for any.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin / superuser bearer key. REQUIRED to create orgs via the public API.
# Treat as a credential — never commit.
SUPERUSER_KEY=replace-me-with-a-long-random-string

# GitHub OAuth app credentials for the GitHub connection feature.
# Leave blank to disable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Postgres backup layer (optional) ──────────────────────────────────────────
# Connection string for the Supabase Postgres instance that stores periodic
# snapshots of the SQLite store. Set this to enable the backup subsystem.
# When unset, the backup layer logs a warning and is disabled — the rest of
# the app keeps working normally.
# Treat this value as a credential — never commit the real connection string.
BACKUP_DATABASE_URL=postgres://user:password@host:5432/postgres

# Hours between automatic backups. Default 6. Manual backups via the API
# are unaffected by this setting.
BACKUP_INTERVAL_HOURS=6
