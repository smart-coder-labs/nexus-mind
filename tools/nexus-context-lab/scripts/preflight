#!/usr/bin/env python3
import argparse, os, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from nxgold import preflight

parser = argparse.ArgumentParser(description="Fail-closed offline lab preflight")
parser.add_argument("--env", type=Path, required=True)
args = parser.parse_args()
env = {}
for line in args.env.read_text(encoding="utf-8").splitlines():
    line = line.strip()
    if line and not line.startswith("#") and "=" in line:
        key, value = line.split("=", 1)
        env[key.strip()] = value.strip()
errors = preflight(env, Path.cwd())
if errors:
    print("PREFLIGHT: REJECTED")
    for error in errors:
        print(f"- {error}")
    raise SystemExit(1)
print("PREFLIGHT: PASS (offline, no network, no Docker)")
