{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusmind.dev/schemas/factory/routing-decision-v1.schema.json",
  "title": "Factory RoutingDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_type", "execution_tier", "risk", "confidence", "required_checks", "human_approval_required", "decided_by", "actions"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "task_type": { "type": "string", "minLength": 1, "maxLength": 64 },
    "execution_tier": { "enum": ["DETERMINISTIC", "DECISION_MODEL", "LOCAL_SMALL", "CHEAP_CLOUD", "FRONTIER"] },
    "risk": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "blast_radius": { "enum": ["single_symbol", "single_file", "package", "service", "cross_service"] },
    "risk_factors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_context": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "required_checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "max_attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
    "human_approval_required": { "type": "boolean" },
    "decided_by": {
      "type": "object", "additionalProperties": false, "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "actions": {
      "type": "object",
      "propertyNames": { "enum": ["fix", "publish", "open_pr", "reply", "close", "approve", "merge", "deploy", "notify", "recover"] },
      "additionalProperties": { "$ref": "#/$defs/actionVerdict" }
    }
  },
  "$defs": {
    "actionVerdict": {
      "type": "object", "additionalProperties": false, "required": ["verdict", "reason", "source"],
      "properties": {
        "verdict": { "enum": ["allow", "hold", "deny"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "source": { "enum": ["policy", "floor", "decision_model", "human"] }
      }
    }
  }
}
