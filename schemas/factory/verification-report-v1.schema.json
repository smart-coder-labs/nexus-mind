{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusmind.dev/schemas/factory/verification-report-v1.schema.json",
  "title": "Factory VerificationReport v1",
  "description": "Machine-verifiable evidence for exactly one commit (head_sha).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "head_sha", "passed", "checks", "blocking_failures", "eligible_for_merge", "human_approval_required"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "passed": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "status": { "enum": ["PASS", "FAIL", "SKIP", "ERROR"] },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "artifact": { "type": ["string", "null"], "maxLength": 1024 }
        }
      }
    },
    "blocking_failures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "eligible_for_merge": { "type": "boolean" },
    "human_approval_required": { "type": "boolean" }
  },
  "allOf": [
    {
      "$comment": "Merge eligibility requires a passing report with no blocking failures.",
      "if": { "properties": { "eligible_for_merge": { "const": true } } },
      "then": { "properties": { "passed": { "const": true }, "blocking_failures": { "maxItems": 0 } } }
    }
  ]
}
